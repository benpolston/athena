#!/usr/bin/env python3
"""Show live Hyprland keybinds (those with a `description`) in wofi."""
import json, subprocess

MODS = [(64, "SUPER"), (1, "Shift"), (4, "Ctrl"), (8, "Alt")]
KEYS = {"slash": "/", "Escape": "Esc", "mouse:272": "left-drag", "mouse:273": "right-drag",
        "mouse_down": "scroll", "mouse_up": "scroll"}
ARROWS = {"left", "right", "up", "down"}

binds = json.loads(subprocess.run(["hyprctl", "binds", "-j"], capture_output=True, text=True).stdout)
groups = {}  # (modmask, description) -> [keys], insertion order = config order
for b in binds:
    if b.get("has_description") and b.get("description"):
        groups.setdefault((b["modmask"], b["description"]), []).append(b["key"])

rows = []
for (mask, desc), keys in groups.items():
    mods = [n for bit, n in MODS if mask & bit]
    if set(keys) == ARROWS:
        key = "arrows"
    elif "workspace" in desc and keys[0] in "1234567890":
        key = "1-0"
    else:
        key = KEYS.get(keys[0], keys[0])
    rows.append(("+".join(mods + [key]).replace("+", " + "), desc))

w = max(len(k) for k, _ in rows) + 3
text = "\n".join(f"{k:<{w}}{d}" for k, d in rows)

# Size to the monitor: ~85% of logical height, minus the bar.
mon = json.loads(subprocess.run(["hyprctl", "monitors", "-j"], capture_output=True, text=True).stdout)[0]
h = int(mon["height"] / mon["scale"] * 0.85) - 42
subprocess.run(["wofi", "--dmenu", "--prompt", "Shortcuts", "--width", "620", "--height", str(h),
                "--cache-file", "/dev/null", "--style", f"{__import__('os').path.expanduser('~/.config/wofi/cheatsheet.css')}"],
               input=text, text=True, stdout=subprocess.DEVNULL)
