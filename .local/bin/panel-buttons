#!/usr/bin/env python3
"""Reorder the notification panel's buttons with two wofi menus: pick a button, pick where it goes."""
import json, os, subprocess

CFG = os.path.expanduser("~/.config/swaync/config.json")

def wofi(prompt, items):
    r = subprocess.run(["wofi", "--dmenu", "--prompt", prompt, "--width", "380", "--height", "420",
                        "--cache-file", "/dev/null", "--insensitive"],
                       input="\n".join(items), text=True, capture_output=True)
    return r.stdout.strip() if r.returncode == 0 else None

def main():
    while True:
        cfg = json.load(open(CFG))
        acts = cfg["widget-config"]["buttons-grid"]["actions"]
        names = [f'{a["label"]}  {a.get("tooltip", a["command"])}' for a in acts]
        pick = wofi("Move which button?", [f"{i+1}. {n}" for i, n in enumerate(names)])
        if not pick:
            return
        src = int(pick.split(".")[0]) - 1
        targets = [f"{i+1}. {n}" for i, n in enumerate(names)] + ["→ at the end"]
        where = wofi(f"Put {names[src].split('  ', 1)[1]} before…", targets)
        if not where:
            continue
        item = acts.pop(src)
        if where.startswith("→"):
            acts.append(item)
        else:
            dst = int(where.split(".")[0]) - 1
            acts.insert(dst if dst <= src else dst - 1, item)
        json.dump(cfg, open(CFG, "w"), indent=2, ensure_ascii=False)
        subprocess.run(["swaync-client", "-R"], capture_output=True)
        subprocess.run(["swaync-client", "-op"], capture_output=True)   # show the result

main()
