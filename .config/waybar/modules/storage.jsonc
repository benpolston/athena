{
  "disk": {
    "tooltip": false,
    "interval": 3600,
    "path": "/",
    "unit": "GB",
    "format": "󱙋 <span size='11pt'>{specific_used:0.2f}G</span>",
    "states": {
      "warning": 80,
      "critical": 90
    }
  },
  "memory": {
    "tooltip": false,
    "interval": 15,
    "format": "󰍛 <span size='11pt'>{used:0.2f}G</span>",
    "states": {
      "warning": 75,
      "critical": 85
    }
  }
}
