{
  "hyprland/workspaces": {
    "format": "{icon} {windows}",
    "on-click": "activate",
    "persistent-workspaces": { "*": 5 },
    "window-rewrite-default": "󰊠",
    "window-rewrite": {
      "kitty": "󰆍",
      "google-chrome": "",
      "firefox": "",
      "org.kde.dolphin": "",
      "thunar": "",
      "mpv": "󰕼",
      "vlc": "󰕼",
      "blueman-manager": "",
      "pavucontrol": "󱕂",
      "nm-connection-editor": "󰐻"
    },
    "format-icons": {
      "active": "󰮯",
      "special": "󱁂",
      "default": "󰊠",
      "urgent": "󰧵",
      "empty": ""
    },
    "show-special": true,
    "all-outputs": true
  }
}
