{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "source": "arch_small", "padding": { "top": 1, "right": 3 } },
  "display": { "separator": "  ", "color": { "keys": "blue" } },
  "modules": [
    "break",
    { "type": "title", "format": "{user-name}@{host-name}" },
    { "type": "os",       "key": "󰣇" },
    { "type": "kernel",   "key": "\uf17c" },
    { "type": "wm",       "key": "\uf2d0" },
    { "type": "terminal", "key": "\uf120" },
    { "type": "shell",    "key": "\ue795" },
    { "type": "uptime",   "key": "󰅐" },
    { "type": "packages", "key": "󰏖" },
    { "type": "cpu",      "key": "\uf4bc", "showPeCoreCount": true },
    { "type": "memory",   "key": "\uf2db" },
    { "type": "battery",  "key": "󰁹" },
    "break",
    "colors"
  ]
}
